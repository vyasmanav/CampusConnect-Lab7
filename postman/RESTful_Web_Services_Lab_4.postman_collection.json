{
  "info": {
    "_postman_id": "lab4-student-api-rest-collection",
    "name": "RESTful Web Services – Lab 4 (MongoDB Atlas)",
    "description": "Postman test collection for Lab 4 Full-Stack RESTful Student Management API with MongoDB Atlas persistence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. List All Students (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Fetch all students stored in MongoDB."
      },
      "response": []
    },
    {
      "name": "2. Create Student (POST 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Patel\",\n  \"email\": \"aarav.atlas@example.com\",\n  \"course\": \"Computer Science\",\n  \"semester\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Create a new student in MongoDB."
      },
      "response": []
    },
    {
      "name": "3. Create Duplicate Email - Constraint Test (POST 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"aarav.atlas@example.com\",\n  \"course\": \"IT\",\n  \"semester\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Negative Test: Verify unique email index constraint returns 400 Bad Request."
      },
      "response": []
    },
    {
      "name": "4. Create Student - Invalid Validation (POST 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"semester\": -5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Negative Test: Input validation error returns 400."
      },
      "response": []
    },
    {
      "name": "5. Get Student by ID (GET 200 / 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/6650a8b9f1a23c0012345678",
          "host": ["{{baseUrl}}"],
          "path": ["students", "6650a8b9f1a23c0012345678"]
        }
      },
      "response": []
    },
    {
      "name": "6. Update Student (PUT 200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Patel (Updated)\",\n  \"email\": \"aarav.atlas.updated@example.com\",\n  \"course\": \"AI & Data Science\",\n  \"semester\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        }
      },
      "response": []
    },
    {
      "name": "7. Delete Student (DELETE 200 / 204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        }
      },
      "response": []
    }
  ]
}
