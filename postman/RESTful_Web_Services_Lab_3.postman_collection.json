{
  "info": {
    "_postman_id": "lab3-student-api-rest-collection",
    "name": "RESTful Web Services – Lab 3",
    "description": "Postman test collection for Lab 3 RESTful Student Management API in Express.js (Port 3000) and Spring Boot (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. List All Students (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Fetch all students stored in memory."
      },
      "response": []
    },
    {
      "name": "2. Get Student by ID - Success (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        },
        "description": "Fetch single student with ID 1."
      },
      "response": []
    },
    {
      "name": "3. Get Student by ID - Not Found (GET 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "999"]
        },
        "description": "Negative Test: Fetching a non-existent student ID."
      },
      "response": []
    },
    {
      "name": "4. Create Student - Success (POST 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Patel\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Computer Science\",\n  \"semester\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Create a new student with valid payload."
      },
      "response": []
    },
    {
      "name": "5. Create Student - Invalid Body (POST 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid-email\",\n  \"semester\": -2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Negative Test: Trigger 400 Bad Request with missing course, invalid email, empty name, and negative semester."
      },
      "response": []
    },
    {
      "name": "6. Update Student - Success (PUT 200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Patel (Updated)\",\n  \"email\": \"aarav.updated@example.com\",\n  \"course\": \"Data Science & AI\",\n  \"semester\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        },
        "description": "Update existing student."
      },
      "response": []
    },
    {
      "name": "7. Update Student - Not Found (PUT 404)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ghost Student\",\n  \"email\": \"ghost@example.com\",\n  \"course\": \"CS\",\n  \"semester\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/9999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "9999"]
        },
        "description": "Negative Test: Update non-existent student."
      },
      "response": []
    },
    {
      "name": "8. Delete Student - Success (DELETE 200/204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        },
        "description": "Delete student by ID."
      },
      "response": []
    },
    {
      "name": "9. Delete Student - Not Found (DELETE 404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/9999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "9999"]
        },
        "description": "Negative Test: Delete non-existent student."
      },
      "response": []
    }
  ]
}
